<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.develapp</groupId>
    <artifactId>step-lexer-java</artifactId>
    <version>1.12.0</version>
    <packaging>jar</packaging>

    <name>StepLexer Java Bindings</name>
    <description>Java bindings for DevelApp.StepLexer - Zero-copy UTF-8 tokenization with PCRE2 support</description>
    <url>https://github.com/DevelApp-ai/ENFAStepLexer-StepPerser</url>

    <licenses>
        <license>
            <name>AGPL-3.0-or-later</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>DevelApp AI</name>
            <email>info@develapp.ai</email>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- IKVM for .NET interoperability -->
        <dependency>
            <groupId>ikvm</groupId>
            <artifactId>ikvm-runtime</artifactId>
            <version>8.3.0</version>
        </dependency>
        <dependency>
            <groupId>ikvm</groupId>
            <artifactId>ikvm-awt</artifactId>
            <version>8.3.0</version>
        </dependency>
        
        <!-- ICU4J for Unicode support -->
        <dependency>
            <groupId>com.ibm.icu</groupId>
            <artifactId>icu4j</artifactId>
            <version>74.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Implementation-Title>${project.name}</Implementation-Title>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
